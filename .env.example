# Copy this file to .env.local and fill in real values.

# SMTP server used by /api/contact to send the contact-form email.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# "From" header on the outgoing email.
MAIL_FROM="Live Connect <no-reply@example.com>"
# Where the contact form delivers messages.
MAIL_TO=youremail@yourdomain.com

# Google Maps JS API key (exposed to the browser).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
